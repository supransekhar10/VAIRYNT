{
  "name": "@vairynt/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run build --workspace @vairynt/core",
    "dev": "npm run build && node dist/main.js dev",
    "predownload": "npm run build --workspace @vairynt/core",
    "download": "npm run build && node dist/main.js download-files",
    "build": "tsc -p tsconfig.json --noEmit false",
    "typecheck": "tsc -p tsconfig.json",
    "pretest": "npm run build --workspace @vairynt/core",
    "test": "vitest run src --passWithNoTests",
    "benchmark:fencing": "npm run build && node dist/fencing-benchmark.js"
  },
  "dependencies": {
    "@livekit/agents": "^1.8.0",
    "@livekit/agents-plugin-google": "^1.8.0",
    "@livekit/agents-plugin-openai": "^1.8.0",
    "@livekit/agents-plugin-rime": "^1.8.0",
    "@livekit/agents-plugin-silero": "^1.8.0",
    "@livekit/rtc-node": "^0.13.31",
    "@vairynt/core": "0.1.0",
    "dotenv": "^17.4.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.4"
  }
}
