# Same-origin Fastify web service
PORT=3001
SESSION_TTL_SECONDS=300
TOKEN_RATE_LIMIT_MAX=6
TOKEN_RATE_LIMIT_WINDOW_SECONDS=60

# LiveKit voice worker
LIVEKIT_URL=wss://your-livekit-host
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_AGENT_NAME=vairynt-voice

# Rime speech
RIME_API_KEY=your_rime_api_key
RIME_MODEL=your_rime_model
RIME_VOICE=your_rime_voice
RIME_LANGUAGE=en
RIME_USE_WEBSOCKET=true

# Model and transcription providers
GOOGLE_API_KEY=your_google_api_key
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=your_groq_api_key
GROQ_STT_MODEL=your_groq_stt_model

# Synthetic tool timing and cancellation testing
TOOL_DELAY_MS=250
TOOL_TIMEOUT_MS=5000
# Labelled stress mode deliberately lets superseded work ignore cancellation;
# stale-result fencing must still prevent delivery.
TOOL_STRESS_MODE=false
